{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "17851097983510211643"
    }
  },
  "parameters": {
    "appName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique name for the Azure App Service web app."
      }
    },
    "appServicePlanName": {
      "type": "string",
      "defaultValue": "[format('{0}-plan', parameters('appName'))]",
      "metadata": {
        "description": "Name of the App Service plan used by the web app."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the App Service resources."
      }
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "production",
      "metadata": {
        "description": "Logical environment name applied as a tag."
      }
    },
    "appServicePlanSkuName": {
      "type": "string",
      "defaultValue": "B1",
      "metadata": {
        "description": "App Service pricing tier name."
      }
    },
    "appServicePlanSkuTier": {
      "type": "string",
      "defaultValue": "Basic",
      "metadata": {
        "description": "App Service pricing tier family."
      }
    },
    "appServicePlanCapacity": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Number of App Service workers."
      }
    },
    "nodeRuntimeStack": {
      "type": "string",
      "defaultValue": "NODE|20-lts",
      "metadata": {
        "description": "Runtime stack for the Linux App Service."
      }
    },
    "startupCommand": {
      "type": "string",
      "defaultValue": "node server.js",
      "metadata": {
        "description": "Startup command used by the standalone Next.js server."
      }
    },
    "alwaysOn": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Whether the App Service should stay warm between requests."
      }
    },
    "blogSourceProvider": {
      "type": "string",
      "defaultValue": "local",
      "allowedValues": [
        "local",
        "github"
      ],
      "metadata": {
        "description": "Blog source provider passed to the application runtime."
      }
    },
    "blogSourcePath": {
      "type": "string",
      "defaultValue": "content/blog",
      "metadata": {
        "description": "Path used by the blog source adapter."
      }
    },
    "blogSourceOwner": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "GitHub owner for the remote blog source when github mode is enabled."
      }
    },
    "blogSourceRepo": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "GitHub repository for the remote blog source when github mode is enabled."
      }
    },
    "blogSourceBranch": {
      "type": "string",
      "defaultValue": "main",
      "metadata": {
        "description": "GitHub branch for the remote blog source when github mode is enabled."
      }
    },
    "blogSourceToken": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Optional GitHub token used for private repository access."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Additional tags applied to the provisioned resources."
      }
    }
  },
  "variables": {
    "mergedTags": "[union(parameters('tags'), createObject('environment', parameters('environmentName'), 'managedBy', 'bicep', 'workload', 'm0x6a-portfolio-blog'))]",
    "baseAppSettings": {
      "BLOG_SOURCE_PATH": "[parameters('blogSourcePath')]",
      "BLOG_SOURCE_PROVIDER": "[parameters('blogSourceProvider')]",
      "NODE_ENV": "production",
      "SCM_DO_BUILD_DURING_DEPLOYMENT": "false",
      "WEBSITE_RUN_FROM_PACKAGE": "1"
    },
    "gitHubAppSettings": "[if(equals(parameters('blogSourceProvider'), 'github'), createObject('BLOG_SOURCE_BRANCH', parameters('blogSourceBranch'), 'BLOG_SOURCE_OWNER', parameters('blogSourceOwner'), 'BLOG_SOURCE_REPO', parameters('blogSourceRepo')), createObject())]",
    "secureAppSettings": "[if(empty(parameters('blogSourceToken')), createObject(), createObject('BLOG_SOURCE_TOKEN', parameters('blogSourceToken')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[parameters('appServicePlanName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "capacity": "[parameters('appServicePlanCapacity')]",
        "name": "[parameters('appServicePlanSkuName')]",
        "tier": "[parameters('appServicePlanSkuTier')]"
      },
      "properties": {
        "reserved": true
      },
      "tags": "[variables('mergedTags')]"
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "httpsOnly": true,
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]"
      },
      "tags": "[variables('mergedTags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}/{1}', parameters('appName'), 'web')]",
      "properties": {
        "alwaysOn": "[parameters('alwaysOn')]",
        "appCommandLine": "[parameters('startupCommand')]",
        "ftpsState": "Disabled",
        "healthCheckPath": "/",
        "http20Enabled": true,
        "linuxFxVersion": "[parameters('nodeRuntimeStack')]",
        "minTlsVersion": "1.2"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}/{1}', parameters('appName'), 'appsettings')]",
      "properties": "[union(variables('baseAppSettings'), variables('gitHubAppSettings'), variables('secureAppSettings'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ]
    }
  ],
  "outputs": {
    "webAppName": {
      "type": "string",
      "value": "[parameters('appName')]"
    },
    "webAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2022-09-01').defaultHostName)]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2022-09-01', 'full').identity.principalId]"
    }
  }
}